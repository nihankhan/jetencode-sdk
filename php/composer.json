{
    "name": "gotipath/jetencode",
    "description": "Official PHP client for the JetEncode transcoding API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "classmap": ["src/Models.php"],
        "psr-4": {
            "JetEncode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JetEncode\\Tests\\": "tests/"
        }
    }
}
